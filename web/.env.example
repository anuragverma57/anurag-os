# =============================================================================
# Anurag OS — Phase 1 (Foundation: auth + admin vs public)
# Copy to `.env.local` (Next.js) and fill values. Never commit real secrets.
# =============================================================================

# --- App URLs (used for redirects, absolute links, and OAuth-style return URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase Console → Authentication → Sign-in method: enable Email/Password (for /admin login).
# Firebase Console → Firestore Database → Create database (Phase 2 projects). Server uses Admin SDK only.

# --- Firebase — Web / client (Firebase Console → Project settings → Your apps)
# Safe to expose in the browser; still keep in env for one place to configure.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=

# Optional — only if you enable Google Analytics in Firebase
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Firebase — Admin SDK (server-only: API routes / middleware / session verification)
# Get a service account key: Firebase Console → Project settings → Service accounts
# Prefer ONE of: (A) JSON file path, OR (B) inline fields below.

# (A) Path to the downloaded service account JSON (local dev; do not commit the file)
# FIREBASE_SERVICE_ACCOUNT_PATH=

# (B) Inline service account fields (good for Vercel/hosting env UI; escape newlines in private key)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Use quotes; keep \n for line breaks in the key body if pasting into a single line
FIREBASE_PRIVATE_KEY=

# --- Single-admin policy
# Email of the ONE Firebase Auth user allowed to use /admin (must match login email)
ADMIN_EMAIL=

# --- Optional — session / cookie signing (if the stack uses a server session secret)
# Generate a long random string for production
# AUTH_SECRET=
